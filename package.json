{
  "name": "cita-medica-lambda",
  "version": "1.0.0",
  "description": "Lambda function for medical appointment system",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc",
    "deploy": "npm run build && serverless deploy",
    "deploy:dev": "npm run build && sls deploy   -r us-east-1 -s test --aws-profile DEV && npm run setup-sns:dev",
    "deploy:test": "npm run build && serverless deploy --stage test && npm run setup-sns:test",
    "setup-sns:dev": "STAGE=dev node scripts/setup-sns-subscriptions.js",
    "setup-sns:test": "STAGE=test node scripts/setup-sns-subscriptions.js",
    "test": "jest",
    "dev": "serverless offline start",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "lambda",
    "serverless",
    "typescript",
    "medical"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.133",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.8.10",
    "jest": "^29.7.0",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0",
    "serverless-plugin-typescript": "^2.1.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "aws-sdk": "^2.1490.0",
    "uuid": "^11.1.0"
  }
}
